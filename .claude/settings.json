{
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*firebase-adminsdk*.json)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Edit(./.claude/**)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(vercel env pull*)",
      "Edit(./ia/hook/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx expo install *)",
      "Bash(vercel *)",
      "Bash(eas *)"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/ia/hook/guard.mjs\"" }]
      }
    ]
  }
}
